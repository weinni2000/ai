<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ai_open_IAP_module.ListController">
        <div t-att-class="this.className" t-ref="this.rootRef">
            <Layout
                className="this.model.useSampleModel ? 'o_view_sample_data' : ''"
                display="this.display"
            >
                <t t-set-slot="control-panel-buttons">
                    <t t-call="{{ this.props.buttonTemplate }}" />
                    <t
                        t-foreach="this.archInfo.headerButtons"
                        t-as="button"
                        t-key="button.id"
                        t-if="!this.evalViewModifier(button.invisible)"
                    >
                        <MultiRecordViewButton
                            t-if="button.display === 'always'"
                            list="this.model.root"
                            className="button.className"
                            clickParams="button.clickParams"
                            defaultRank="'btn-secondary'"
                            domain="this.props.domain"
                            icon="button.icon"
                            iconClass="button.iconClass"
                            string="button.string"
                            title="button.title"
                            attrs="button.attrs"
                        />
                    </t>
                </t>

                <t t-set-slot="control-panel-actions">
                    <SearchBar
                        t-if="!this.offlinePlugin.isOffline()"
                        toggler="this.searchBarToggler"
                        autofocus="this.firstLoad"
                    />
                    <OfflineSearchBar
                        t-if="this.offlinePlugin.isOffline()"
                        toggler="this.searchBarToggler"
                        autofocus="this.firstLoad"
                    />
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                    <t t-if="!this.hasSelectedRecords">
                        <t
                            t-if="this.offlinePlugin.isOffline()"
                            t-component="this.searchBarToggler.offlineComponent"
                            t-props="this.searchBarToggler.props"
                        />
                        <t
                            t-if="!this.offlinePlugin.isOffline()"
                            t-component="this.searchBarToggler.component"
                            t-props="this.searchBarToggler.props"
                        />
                    </t>
                </t>

                <t t-set-slot="control-panel-additional-actions">
                    <CogMenu t-if="!this.hasSelectedRecords" />
                    <CogMenu
                        t-if="this.hasSelectedRecords and this.uiService.isSmall and (this.props.info.actionMenus or this.archInfo.headerButtons.length)"
                        t-props="this.actionMenuProps"
                        hasSelectedRecords="this.hasSelectedRecords"
                    >
                        <t
                            t-foreach="this.archInfo.headerButtons"
                            t-as="button"
                            t-key="button.id"
                            t-if="!this.evalViewModifier(button.invisible)"
                        >
                            <DropdownItem class="'o-dropdown-item-unstyled-button'">
                                <MultiRecordViewButton
                                    t-if="button.display !== 'always'"
                                    list="this.model.root"
                                    className="button.className"
                                    clickParams="button.clickParams"
                                    defaultRank="'btn-secondary'"
                                    domain="this.props.domain"
                                    icon="button.icon"
                                    iconClass="button.iconClass"
                                    string="button.string"
                                    title="button.title"
                                    attrs="button.attrs"
                                />
                            </DropdownItem>
                        </t>
                    </CogMenu>
                </t>
                <t t-set-slot="control-panel-selection-actions">
                    <div
                        t-if="this.hasSelectedRecords"
                        class="o_selection_container m-1 m-md-0 d-flex gap-1"
                    >
                        <SelectionBox root="this.model.root" />
                        <t t-if="!this.uiService.isSmall">
                            <t
                                t-foreach="this.archInfo.headerButtons"
                                t-as="button"
                                t-key="button.id"
                                t-if="!this.evalViewModifier(button.invisible)"
                            >
                                <MultiRecordViewButton
                                    t-if="button.display !== 'always'"
                                    list="this.model.root"
                                    className="button.className"
                                    clickParams="button.clickParams"
                                    defaultRank="'btn-secondary'"
                                    domain="this.props.domain"
                                    icon="button.icon"
                                    iconClass="button.iconClass"
                                    string="button.string"
                                    title="button.title"
                                    attrs="button.attrs"
                                />
                            </t>
                            <t t-if="this.props.info.actionMenus">
                                <ActionMenus t-props="this.actionMenuProps" />
                            </t>
                        </t>
                    </div>
                </t>
                <div class="o_ai_connection_list_shell">
                    <aside class="o_ai_connection_sidebar">
                        <div class="o_ai_connection_sidebar_header">
                            <span>Odoo AI provider</span>
                        </div>
                        <t t-set="credits" t-value="this.connectionSidebar.credits" />
                        <button
                            type="button"
                            t-att-class="'o_ai_connection_sidebar_item o_ai_connection_sidebar_standard ' + (!this.connectionSidebar.loading and !this.connectionSidebar.selectedConnectionId ? 'active' : '')"
                            t-on-click="() => this.selectOpenIapConnection(false)"
                        >
                            <span
                                class="o_ai_connection_sidebar_name"
                            >Odoo IAP (standard)</span>
                            <span class="o_ai_connection_sidebar_meta">
                                <t t-if="credits.loading">Loading credits…</t>
                                <t t-elif="!credits.hasAccount">No IAP account yet</t>
                                <t
                                    t-elif="credits.credit === -1"
                                >Credits unavailable</t>
                                <t t-else="">Credits: <t t-esc="credits.credit" /></t>
                            </span>
                        </button>
                        <a
                            t-if="credits.buyUrl"
                            class="o_ai_connection_sidebar_buy"
                            t-att-href="credits.buyUrl"
                            target="_blank"
                        >Buy credits</a>
                        <div
                            class="o_ai_connection_sidebar_header o_ai_connection_sidebar_subheader"
                        >
                            <span>Replacement</span>
                        </div>
                        <div
                            t-if="this.connectionSidebar.loading"
                            class="o_ai_connection_sidebar_empty"
                        >
                            Loading
                        </div>
                        <div
                            t-if="!this.connectionSidebar.loading"
                            class="o_ai_connection_sidebar_items"
                        >
                            <button
                                t-foreach="this.connectionSidebar.connections"
                                t-as="connection"
                                t-key="connection.id"
                                type="button"
                                t-att-class="'o_ai_connection_sidebar_item ' + (connection.id === this.connectionSidebar.selectedConnectionId ? 'active' : '')"
                                t-on-click="() => this.selectOpenIapConnection(connection.id)"
                            >
                                <span
                                    class="o_ai_connection_sidebar_name"
                                    t-esc="connection.name"
                                />
                                <span class="o_ai_connection_sidebar_meta">
                                    <t t-esc="connection.kind_label" />
                                    <t t-if="connection.model"> · <t
                                        t-esc="connection.model"
                                    /></t>
                                    <t t-if="connection.supports_images"> · images</t>
                                </span>
                            </button>
                        </div>
                        <div
                            t-if="!this.connectionSidebar.loading"
                            class="o_ai_connection_sidebar_routing"
                        >
                            <div
                                class="o_ai_connection_sidebar_header o_ai_connection_sidebar_subheader"
                            >
                                <span>Routing</span>
                            </div>
                            <div class="o_ai_connection_sidebar_label">Endpoint</div>
                            <div
                                class="o_ai_connection_sidebar_value"
                                t-att-title="this.connectionSidebar.endpoint"
                                t-esc="this.connectionSidebar.endpoint"
                            />
                            <div class="o_ai_connection_sidebar_label">Webhook URL</div>
                            <div
                                class="o_ai_connection_sidebar_value"
                                t-att-title="this.connectionSidebar.webhookUrl"
                                t-esc="this.connectionSidebar.webhookUrl"
                            />
                        </div>
                    </aside>
                    <div class="o_ai_connection_list_content">
                        <t
                            t-component="this.props.Renderer"
                            t-if="this.model.isReady()"
                            list="this.model.root"
                            activeActions="this.activeActions"
                            archInfo="this.archInfo"
                            allowSelectors="this.props.allowSelectors"
                            editable="this.editable"
                            onOpenFormView="this.onOpenFormView"
                            hasOpenFormViewButton="this.hasOpenFormViewButton"
                            openRecord.bind="this.openRecord"
                            noContentHelp="this.props.info.noContentHelp"
                            onAdd.bind="this.createRecord"
                            optionalActiveFields="this.optionalActiveFields"
                            readonly="this.props.readonly"
                        />
                        <t t-if="this.model.couldNotLoadRootOffline">
                            <OfflineActionHelper />
                        </t>
                    </div>
                </div>
            </Layout>
        </div>
    </t>
</templates>
