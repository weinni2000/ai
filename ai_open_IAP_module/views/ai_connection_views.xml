<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ai_connection_form_view" model="ir.ui.view">
        <field name="model">ai.connection</field>
        <field name="inherit_id" ref="ai_private.ai_connection_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='model']" position="attributes">
                <attribute name="invisible">kind != 'openai_compatible'</attribute>
            </xpath>
            <xpath expr="//field[@name='model']" position="after">
                <field
                    name="model_choice"
                    invisible="kind not in ('claude', 'deepseek', 'gemini')"
                    required="kind in ('claude', 'deepseek', 'gemini')"
                />
                <field name="supports_images" />
            </xpath>
            <xpath expr="//field[@name='api_key']" position="attributes">
                <attribute
                    name="invisible"
                >kind not in ('claude', 'deepseek', 'gemini', 'openai_compatible')</attribute>
            </xpath>
            <xpath expr="//field[@name='url']" position="attributes">
                <attribute
                    name="invisible"
                >kind not in ('claude', 'deepseek', 'gemini', 'openai_compatible')</attribute>
            </xpath>
            <xpath expr="//field[@name='temperature']" position="attributes">
                <attribute
                    name="invisible"
                >kind not in ('deepseek', 'gemini', 'openai_compatible')</attribute>
            </xpath>
        </field>
    </record>

    <record id="ai_connection_list_view" model="ir.ui.view">
        <field name="model">ai.connection</field>
        <field name="inherit_id" ref="ai_connection.ai_connection_list_view" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">ai_connection_list_with_sidebar</attribute>
            </xpath>
            <xpath expr="//field[@name='kind']" position="after">
                <field name="model" optional="hide" groups="base.group_system" />
                <field name="url" optional="hide" groups="base.group_system" />
                <field name="temperature" optional="hide" />
                <field name="supports_images" optional="hide" />
                <field name="active" optional="hide" widget="boolean_toggle" />
                <button
                    name="action_open_connection"
                    type="object"
                    string="Open"
                    icon="fa-external-link"
                    class="btn-link"
                />
            </xpath>
        </field>
    </record>
</odoo>
