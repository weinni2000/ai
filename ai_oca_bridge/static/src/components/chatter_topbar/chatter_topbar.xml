<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="ai_oca_bridge.ChatterTopbar"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[@t-on-click='this.onClickSearch']" position="after">
            <ChatterAITopbar
                record="this"
                t-if="this.webChatterProps.record and this.webChatterProps.record.data.ai_bridge_info and this.webChatterProps.record.data.ai_bridge_info.length > 0"
            />
        </xpath>
    </t>
</templates>
